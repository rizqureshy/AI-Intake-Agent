# Copy this file to .env (or set these in Replit "Secrets") and fill in your key.

# Required for AI features (document extraction, wording help, ROI narrative, BRD generation).
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o.
OPENAI_MODEL=gpt-4o

# Optional. Only set if you proxy the OpenAI API through a custom base URL.
OPENAI_BASE_URL=

# Optional. Replit sets PORT automatically; defaults to 3000 locally.
PORT=3000
